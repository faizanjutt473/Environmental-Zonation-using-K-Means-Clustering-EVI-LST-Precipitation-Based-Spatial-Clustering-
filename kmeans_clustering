import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

from sklearn.preprocessing import StandardScaler
from sklearn.cluster import KMeans
from sklearn.metrics import silhouette_score, adjusted_rand_score, normalized_mutual_info_score
# Load dataset

df = pd.read_csv("1.csv")

print("Shape:", df.shape)
print(df.head())
print(df.info())
print(df.isnull().sum())

# columns in this dataset:
# Longitude, Latitude -> location of each point
# EVI, LST, precipitation -> environmental features (used for clustering)
# Zona_Cluster -> an existing zone label already in the data, kept aside just to compare later

zone_label = df["Zona_Cluster"]

feature_cols = ["EVI", "LST", "precipitation"]
X_raw = df[feature_cols]

print("\nFeatures used for clustering:", feature_cols)
print(X_raw.describe())


# Scale features

scaler = StandardScaler()
X = scaler.fit_transform(X_raw)


# Elbow method + silhouette score to find best k

wcss = []
sil_scores = []
k_values = range(2, 11)

for k in k_values:
    km = KMeans(n_clusters=k, init="k-means++", n_init=10, random_state=42)
    labels = km.fit_predict(X)
    wcss.append(km.inertia_)
    sil_scores.append(silhouette_score(X, labels))
    print(f"k={k} -> inertia={km.inertia_:.2f}, silhouette={sil_scores[-1]:.4f}")

plt.figure(figsize=(10, 4))

plt.subplot(1, 2, 1)
plt.plot(list(k_values), wcss, marker="o")
plt.title("Elbow Method")
plt.xlabel("k")
plt.ylabel("WCSS")

plt.subplot(1, 2, 2)
plt.plot(list(k_values), sil_scores, marker="o", color="orange")
plt.title("Silhouette Score")
plt.xlabel("k")
plt.ylabel("Score")

plt.tight_layout()
plt.savefig("elbow_silhouette.png")
plt.show()


# Final model
# dataset already has 2 existing zones (4 and 5) so starting with k=2
# change k below if elbow/silhouette plot suggests a different value

k = 2
kmeans = KMeans(n_clusters=k, init="k-means++", n_init=25, random_state=42)
clusters = kmeans.fit_predict(X)

df["cluster"] = clusters

print("\nFinal silhouette score:", silhouette_score(X, clusters))
print("\nCluster sizes:")
print(df["cluster"].value_counts())


# Cluster profiling - mean of each feature per cluster

profile = df.groupby("cluster")[feature_cols].mean()
print("\nCluster profile (mean values):")
print(profile)

plt.figure(figsize=(6, 4))
sns.heatmap(profile.T, cmap="coolwarm", annot=True, fmt=".3f")
plt.title("Cluster Feature Profile")
plt.tight_layout()
plt.savefig("cluster_profile.png")
plt.show()


# Scatter plot of clusters using EVI vs LST

plt.figure(figsize=(8, 6))
plt.scatter(df["EVI"], df["LST"], c=clusters, cmap="Set1", s=20, alpha=0.7)
centers_original = scaler.inverse_transform(kmeans.cluster_centers_)
plt.scatter(centers_original[:, 0], centers_original[:, 1], c="black", marker="X", s=200, label="Centroids")
plt.title(f"K-Means Clusters (k={k}) - EVI vs LST")
plt.xlabel("EVI")
plt.ylabel("LST")
plt.legend()
plt.savefig("clusters_evi_lst.png")
plt.show()


# Spatial map of clusters using Longitude/Latitude

plt.figure(figsize=(8, 6))
plt.scatter(df["Longitude"], df["Latitude"], c=clusters, cmap="Set1", s=20, alpha=0.7)
plt.title(f"Spatial Distribution of Clusters (k={k})")
plt.xlabel("Longitude")
plt.ylabel("Latitude")
plt.savefig("clusters_map.png")
plt.show()


# Compare clusters with the existing Zona_Cluster label (just for checking, not used in training)

crosstab = pd.crosstab(df["cluster"], zone_label)
print("\nCluster vs existing Zona_Cluster label:")
print(crosstab)

ari = adjusted_rand_score(zone_label, clusters)
nmi = normalized_mutual_info_score(zone_label, clusters)
print(f"\nAdjusted Rand Index: {ari:.4f}")
print(f"Normalized Mutual Info: {nmi:.4f}")


# Save results

df.to_csv("clustered_output.csv", index=False)
print("\nSaved clustered_output.csv")
